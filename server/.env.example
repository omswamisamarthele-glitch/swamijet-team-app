# Settings for the SwamiJet server. "npm run setup" copies this to server/.env.
# Put the password you chose when installing PostgreSQL after "postgres:" below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/swamijet
PORT=8080
# First admin login, created only while the database has no users.
BOOTSTRAP_ADMIN_USER=localadmin
BOOTSTRAP_ADMIN_PASSWORD=LocalTest#2026
