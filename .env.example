# Copy to .env and fill in. Never commit .env.
DOMAIN=swamijet.example.com
# Long random string, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=
# Optional first-run admin login (only used while the database has no users).
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=
BACKUP_KEEP_DAYS=14
# Only if the app is served from a different site than the server (e.g. Cloudflare Pages):
CORS_ORIGINS=
